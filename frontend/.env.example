# Copy to frontend/.env.local to override. By default the Vite dev server proxies /api to :8000.
# In production (Vercel) set VITE_API_BASE_URL to the Render backend origin, with no trailing slash:
# VITE_API_BASE_URL=https://canadian-roots-api.onrender.com
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_PROXY=http://127.0.0.1:8000
