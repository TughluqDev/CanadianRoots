# Copy to backend/.env to override defaults. No secrets are required.
# SQLite database location (default: backend/canadian_roots.db). Use an absolute path if you change it.
# On Render this points at the persistent disk: sqlite:////var/data/canadian_roots.db
# DATABASE_URL=sqlite:////absolute/path/to/canadian_roots.db
# Comma-separated origins allowed to call the API directly (Vite proxies /api in development).
# On Render, set this to your Vercel URL, e.g. https://canadian-roots.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. Vercel preview deployments:
# CORS_ORIGIN_REGEX=^https://canadian-roots(-[a-z0-9-]+)?\.vercel\.app$
# Seed/update the destinations every time the server starts (idempotent; keeps saved trips).
# SEED_ON_STARTUP=true
