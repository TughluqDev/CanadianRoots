# Copy to backend/.env to override defaults. No secrets are required.
# SQLite database location (default: backend/canadian_roots.db). Use an absolute path if you change it.
# DATABASE_URL=sqlite:////absolute/path/to/canadian_roots.db
# Comma-separated origins allowed to call the API directly (Vite proxies /api in development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
